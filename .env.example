# Alpaca API Credentials
# Get these from: https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here

# Set to 'paper' for paper trading (recommended for testing)
# Set to 'live' for real trading (BE CAREFUL!)
ALPACA_ENV=paper

# LLM API Configuration (OpenAI by default)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: LLM Model to use
LLM_MODEL=gpt-4-turbo-preview

# Scheduler Configuration
# Time to run daily (24-hour format in Mountain Time)
SCHEDULED_HOUR=20
SCHEDULED_MINUTE=0
TIMEZONE=America/Denver

# Logging
LOG_LEVEL=INFO
